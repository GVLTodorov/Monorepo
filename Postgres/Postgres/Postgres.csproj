<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Postgres</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Devspace.Repositories.PostgreSQL</PackageId>
    <Authors>Devspace</Authors>
    <Company>Devspace</Company>
    <Description>Generic PostgreSQL repository using Npgsql/ADO.NET with filtering, paging, soft deletion, and index management.</Description>
    <Copyright>@2026 - Devspace</Copyright>
    <PackageTags>postgresql;postgres;repository;database;ado-net;npgsql</PackageTags>
    <PackageProjectUrl>https://github.com/GVLTodorov/Devspace.Monorepo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GVLTodorov/Devspace.Monorepo.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
